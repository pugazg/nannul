{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pugazg/nannul/blob/main/data/grammatical-terminology-candidates.schema.json",
  "title": "Nannul grammatical-terminology candidate discovery dataset",
  "type": "object",
  "required": [
    "schema_version",
    "work_id",
    "layer_status",
    "source_layers",
    "discovery_policy",
    "counts",
    "reserved_source_gaps",
    "candidates"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "work_id": {"const": "nannul"},
    "layer_status": {"const": "candidate-discovery-unreviewed"},
    "source_layers": {"type": "object"},
    "discovery_policy": {"type": "object"},
    "counts": {
      "type": "object",
      "required": ["canonical_records", "token_occurrences", "all_unique_surface_forms", "candidate_surface_forms", "reviewed_candidates", "accepted_terms", "rejected_candidates"],
      "properties": {
        "canonical_records": {"const": 460},
        "token_occurrences": {"const": 5431},
        "all_unique_surface_forms": {"const": 2837},
        "candidate_surface_forms": {"type": "integer", "minimum": 1},
        "reviewed_candidates": {"const": 0},
        "accepted_terms": {"const": 0},
        "rejected_candidates": {"const": 0}
      },
      "additionalProperties": true
    },
    "reserved_source_gaps": {
      "const": [73, 176]
    },
    "candidates": {
      "type": "array",
      "items": {"$ref": "#/$defs/candidate"}
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "required": [
        "candidate_id",
        "surface_form_ta",
        "review_status",
        "term_decision",
        "term_category",
        "review_notes",
        "discovery_reasons",
        "review_priority_score",
        "review_priority_score_basis",
        "evidence",
        "interpretation_warning",
        "review_rank"
      ],
      "properties": {
        "candidate_id": {
          "type": "string",
          "pattern": "^nannul-term-candidate-[0-9a-f]{16}$"
        },
        "surface_form_ta": {"type": "string", "minLength": 1},
        "review_status": {"const": "unreviewed"},
        "term_decision": {"type": "null"},
        "term_category": {"type": "null"},
        "review_notes": {"type": "null"},
        "discovery_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "exact-surface-frequency>=3",
              "exact-source-heading-token-match"
            ]
          }
        },
        "review_priority_score": {"type": "integer", "minimum": 0},
        "review_priority_score_basis": {
          "type": "array",
          "items": {"type": "string"}
        },
        "review_rank": {"type": "integer", "minimum": 1},
        "evidence": {
          "type": "object",
          "required": [
            "occurrence_count",
            "record_count",
            "major_section_count",
            "structural_unit_count",
            "source_heading_matches",
            "first_occurrence",
            "sample_occurrences"
          ],
          "properties": {
            "occurrence_count": {"type": "integer", "minimum": 1},
            "record_count": {"type": "integer", "minimum": 1},
            "major_section_count": {"type": "integer", "minimum": 1},
            "structural_unit_count": {"type": "integer", "minimum": 1},
            "source_heading_matches": {"type": "array"},
            "first_occurrence": {"type": "object"},
            "sample_occurrences": {"type": "array", "minItems": 1}
          },
          "additionalProperties": true
        },
        "interpretation_warning": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
