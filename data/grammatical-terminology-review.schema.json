{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/pugazg/nannul/blob/main/data/grammatical-terminology-review.schema.json",
  "title": "Nannul grammatical-terminology review ledger",
  "type": "object",
  "required": ["schema_version", "work_id", "source_candidates", "review_guidelines", "layer_status", "counts", "decisions"],
  "properties": {
    "schema_version": {"const": 1},
    "work_id": {"const": "nannul"},
    "source_candidates": {"const": "data/grammatical-terminology-candidates.json"},
    "review_guidelines": {"const": "docs/GRAMMATICAL_TERMINOLOGY_REVIEW_GUIDELINES.md"},
    "layer_status": {"enum": ["review-not-started", "review-in-progress", "review-complete"]},
    "counts": {"type": "object"},
    "decisions": {
      "type": "array",
      "items": {"$ref": "#/$defs/decision"}
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "required": ["candidate_id", "surface_form_ta", "decision", "rationale", "reviewed_record_ids"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^nannul-term-candidate-[0-9a-f]{16}$"},
        "surface_form_ta": {"type": "string", "minLength": 1},
        "decision": {"enum": ["accepted", "rejected", "needs-context"]},
        "term_category": {"type": ["string", "null"]},
        "rationale": {"type": "string", "minLength": 1},
        "reviewed_record_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^nannul-[0-9]{4}$"}
        },
        "term_use_record_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^nannul-[0-9]{4}$"}
        },
        "non_term_use_record_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^nannul-[0-9]{4}$"}
        },
        "external_evidence": {"type": "array"},
        "review_notes": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
